[Unit]
Description=Demetra Process Manager - Linear TODO poller
After=network.target

[Service]
Type=simple
User=manti
WorkingDirectory=/home/manti/.demetra/worktrees/demetra/mnt-40-process-manager
ExecStart=/home/manti/.local/bin/uv --directory /home/manti/.demetra/worktrees/demetra/mnt-40-process-manager run process_manager.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

Environment="LINEAR_API_KEY=%env(LINEAR_API_KEY)"
Environment="LINEAR_TEAM_ID=%env(LINEAR_TEAM_ID)"
Environment="LINEAR_STATE_TODO_ID=%env(LINEAR_STATE_TODO_ID)"
Environment="LINEAR_STATE_IN_PROGRESS_ID=%env(LINEAR_STATE_IN_PROGRESS_ID)"
Environment="LINEAR_STATE_IN_REVIEW_ID=%env(LINEAR_STATE_IN_REVIEW_ID)"
Environment="DB_PATH=%env(DB_PATH)"
Environment="PROJECTS_PATH=%env(PROJECTS_PATH)"

[Install]
WantedBy=multi-user.target
