# Demetra Docker Compose environment
# Copy to .env.docker and fill in real values, e.g.:
#   cp .env.docker.example .env.docker

# Database (used by the app containers and the postgres service in
# docker-compose.yaml — both read these values from this file)
DB_USER=demetra
DB_PASSWORD=demetra
DB_NAME=demetra

# Path to the opencode binary inside the app containers (the image installs
# opencode to /usr/local/bin/opencode; the default in settings.py assumes
# ~/.opencode/bin/opencode which does not exist for the demetra user)
OPENCODE_PATH=/usr/local/bin/opencode

# Path to uv inside the app containers (the image installs uv to /bin/uv)
UV_PATH=/bin/uv

# Host log directory bind-mounted into app containers (default ./log; on
# production set e.g. DEMETRA_LOG_DIR=/mnt/data/www/demetra/log)
# DEMETRA_LOG_DIR=./log

# App secrets - copy real values from the production .env
SECRET_KEY=change-me
ENCRYPTION_SALT=change-me
JWT_SECRET_KEY=change-me
DEFAULT_USER_ID=

# GitHub OAuth + webhook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REDIRECT_URI=https://demetra.manti.by/github/callback

# Issue tracker: "linear" (default) or "clickup". Resolved per project/user via
# the ISSUE_TRACKER env key the same way AGENT_HARNESS is. The watcher polls the
# tracker named here.
# ISSUE_TRACKER=linear

# Linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_TEAM_ID=

# ClickUp (only when ISSUE_TRACKER=clickup). Statuses are per-list labels, not
# ids; the project's "Linear project id" field holds the ClickUp list id.
# CLICKUP_API_TOKEN=
# CLICKUP_TEAM_ID=
# CLICKUP_LIST_ID=
# CLICKUP_STATE_PRD=prd
# CLICKUP_STATE_TODO=to do
# CLICKUP_STATE_IN_PROGRESS=in progress
# CLICKUP_STATE_IN_REVIEW=in review
# CLICKUP_STATE_AWAITING_INPUT=awaiting input
# CLICKUP_STATE_DONE=complete
# CLICKUP_DEFAULT_STATE=prd
# CLICKUP_FEATURE_TAG=feature
# CLICKUP_FILTER_LABELS=
# CLICKUP_RESEARCH_LABELS=Research

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# LangSmith tracing for the opencode
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Demetra

# Web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://demetra.manti.by:8000
COOKIE_SECURE=true
LOG_LEVEL=INFO
LOG_PATH=/var/log/demetra/demetra.log

# Daemons
WATCHER_POLL_INTERVAL=60
LISTENER_POLL_INTERVAL=60

# Research
# MAX_RESEARCH_ATTEMPTS=5
# LINEAR_RESEARCH_LABELS=Research
# OPENCODE_RESEARCH_MODEL=opencode-go/minimax-m3

# Agent harness: "opencode" (default) or "claude". Claude runs on the host OS
# using the current Claude Code login (keychain / ~/.claude); no API key
# plumbing. v1 targets the host, not this Docker image.
# AGENT_HARNESS=opencode
# CLAUDE_PATH=/usr/local/bin/claude
# CLAUDE_PLAN_MODEL=opus
# CLAUDE_PLAN_EFFORT=medium
# CLAUDE_RESOLVE_MODEL=opus
# CLAUDE_RESOLVE_EFFORT=xhigh
# CLAUDE_RESEARCH_MODEL=opus
# CLAUDE_RESEARCH_EFFORT=high
# CLAUDE_BUILD_MODEL=sonnet
# CLAUDE_VALIDATE_MODEL=haiku
# CLAUDE_REVIEW_MODELS=opus:xhigh
# CLAUDE_MAX_BUDGET_USD=5.0
# CLAUDE_BUILD_MAX_BUDGET_USD=15.0
# CLAUDE_IDLE_TIMEOUT=900

# Git signing: populate .keys/.gnupg with the private key matching the
# signingkey in .keys/.gitconfig (commit.gpgsign=true requires a valid key).
