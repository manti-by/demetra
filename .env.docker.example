# Demetra Docker Compose environment
# Copy to .env.docker and fill in real values, e.g.:
#   cp .env.docker.example .env.docker

# Database (used by the app containers and the postgres service in
# docker-compose.yaml). The Demetra MCP server inherits DB_* from the agent
# environment and exits on startup when DB_PASSWORD is not set; store
# DB_PASSWORD as an encrypted project/user environment entry so agents and
# their MCP servers receive it in every clone and worktree.
DB_USER=demetra
DB_PASSWORD=demetra
DB_NAME=demetra
DB_HOST=postgres

# Path to the opencode binary inside the app containers (the image installs
# opencode to /usr/local/bin/opencode; the default in settings.py assumes
# ~/.opencode/bin/opencode which does not exist for the demetra user)
OPENCODE_PATH=/usr/local/bin/opencode

# Path to uv inside the app containers (the image installs uv to /bin/uv)
UV_PATH=/bin/uv

# Host log directory bind-mounted into app containers (default ./log; on
# production set e.g. DEMETRA_LOG_DIR=/mnt/data/www/demetra/log)
# DEMETRA_LOG_DIR=./log

# App secrets - copy real values from the production .env
SECRET_KEY=change-me
ENCRYPTION_SALT=change-me
JWT_SECRET_KEY=change-me
DEFAULT_USER_ID=

# GitHub OAuth + webhook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REDIRECT_URI=https://demetra.manti.by/github/callback

# Linear
# LINEAR_API_KEY is the system default for the Linear MCP Bearer header
# (opencode.json uses {env:LINEAR_API_KEY}); an encrypted project or
# user-shared environment entry overrides it. Keep the real key out of
# tracked files.
LINEAR_API_KEY=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_TEAM_ID=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# LangSmith tracing — one platform key/project is shared by all users and
# projects; the key must be authorized for the project below. Opt-in: tracing
# stays off unless a key is set here and LANGSMITH_TRACING is true.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Demetra

# Web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://demetra.manti.by:8000
COOKIE_SECURE=true
LOG_LEVEL=INFO
LOG_PATH=/var/log/demetra/demetra.log

# Daemons
WATCHER_POLL_INTERVAL=60
LISTENER_POLL_INTERVAL=60

# Deploy daemon (MNT-315; follow-up MNT-316): deploys origin/master once the
# commit's CI checks passed and the RQ job queue drained. DEPLOY_HOST_CHECKOUT
# must be the host path of the checkout the daemon deploys — it is bind-mounted
# at the same path inside the container, so `docker compose` resolves the
# stack's relative bind mounts against the host checkout instead of a
# container-internal copy.
# DEPLOY_HOST_CHECKOUT=/home/manti/www/demetra
# DEPLOYER_POLL_INTERVAL=60
# DEPLOY_MIN_INTERVAL=300
# DEPLOY_DRAIN_TIMEOUT=3600
# DEPLOY_STEP_TIMEOUT=15000
# Every deploy step, including the `up` that force-recreates the workers, must
# be allowed to outlive WORKER_STOP_GRACE_PERIOD; keep this above it.
# DEPLOY_REPOSITORY=manti-by/demetra
# DEPLOY_STATE_PATH=/var/lib/demetra/deployer-state.json
# The reload runs inside the deployer container, which is granted SYS_ADMIN so
# `nsenter` can enter the host namespaces; adjust only if the host nginx is not
# reloadable through `service nginx reload`.
# DEPLOY_NGINX_RELOAD_COMMAND=nsenter -t 1 -m -p -- service nginx reload

# Worker job grace period (MNT-315): how long Compose waits for a worker to
# finish its job before SIGKILL when the deployer force-recreates the workers.
# Keep it at or above the queue's default_timeout (SUBPROCESS_TIMEOUT) plus a
# minute, or an in-flight workflow job dies mid-run on every deploy. The default
# covers the default SUBPROCESS_TIMEOUT of four hours; raise it together with
# that value, and keep DEPLOY_STEP_TIMEOUT above the grace.
# WORKER_STOP_GRACE_PERIOD=14460s

# Research
# MAX_RESEARCH_ATTEMPTS=5
# LINEAR_RESEARCH_LABELS=Research
# OPENCODE_RESEARCH_MODEL=opencode-go/minimax-m3

# Agent network retries (exponential backoff of transient opencode agent
# errors such as ECONNRESET/ETIMEDOUT; defaults in demetra/settings.py are 5
# attempts / 1.0s base — production .env.docker carried 10 / 2 during the
# November 2026 ECONNRESET incident, see wiki/postmortems/2026-11-09)
# MAX_AGENT_NETWORK_ATTEMPTS=5
# AGENT_NETWORK_BACKOFF_BASE=1.0

# Retry budget for other classified agent failures (rate limits and
# in-flight budget rejections); independent of the network retry budget above.
# MAX_AGENT_FAILURE_ATTEMPTS=5

# Git worktrees: by default a session reuses its existing worktree without
# pulling master, and keeps the worktree and branch at the end of the run so a
# rerun continues the same code. Set this to true to drop the worktree and
# branch, pull master and create a fresh worktree before each new session, and
# remove the worktree when a session ends.
# WORKTREE_CLEANUP=false

# Git signing: populate .keys/.gnupg with the private key matching the
# signingkey in .keys/.gitconfig (commit.gpgsign=true requires a valid key).
