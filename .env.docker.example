# Demetra Docker Compose environment
# Copy to .env.docker and fill in real values, e.g.:
#   cp .env.docker.example .env.docker

# Database (used by the app containers and the postgres service in
# docker-compose.yaml — both read these values from this file)
DB_USER=demetra
DB_PASSWORD=demetra
DB_NAME=demetra

# Path to the opencode binary inside the app containers (the image installs
# opencode to /usr/local/bin/opencode; the default in settings.py assumes
# ~/.opencode/bin/opencode which does not exist for the demetra user)
OPENCODE_PATH=/usr/local/bin/opencode

# Path to uv inside the app containers (the image installs uv to /bin/uv)
UV_PATH=/bin/uv

# Host log directory bind-mounted into app containers (default ./log; on
# production set e.g. DEMETRA_LOG_DIR=/mnt/data/www/demetra/log)
# DEMETRA_LOG_DIR=./log

# App secrets - copy real values from the production .env
SECRET_KEY=change-me
ENCRYPTION_SALT=change-me
JWT_SECRET_KEY=change-me
DEFAULT_USER_ID=

# GitHub OAuth + webhook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REDIRECT_URI=https://demetra.manti.by/github/callback

# Linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_TEAM_ID=

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# Web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://demetra.manti.by:8000
COOKIE_SECURE=true
LOG_LEVEL=INFO
LOG_PATH=/var/log/demetra/demetra.log

# Daemons
WATCHER_POLL_INTERVAL=60
LISTENER_POLL_INTERVAL=60

# Git signing: populate .keys/.gnupg with the private key matching the
# signingkey in .keys/.gitconfig (commit.gpgsign=true requires a valid key).
