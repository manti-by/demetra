# Demetra Docker Compose environment
# Copy to .env.docker and fill in real values, e.g.:
#   cp .env.docker.example .env.docker

# Path to the opencode binary inside the app containers (the image installs
# opencode to /usr/local/bin/opencode; the default in settings.py assumes
# ~/.opencode/bin/opencode which does not exist for the demetra user)
OPENCODE_PATH=/usr/local/bin/opencode

# App secrets - copy real values from the production .env
SECRET_KEY=change-me
ENCRYPTION_SALT=change-me
JWT_SECRET_KEY=change-me
DEFAULT_USER_ID=

# GitHub OAuth + webhook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REDIRECT_URI=https://demetra.manti.by/github/callback

# Linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_TEAM_ID=

# Groq
GROQ_API_KEY=

# Web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://demetra.manti.by:8000
COOKIE_SECURE=true
LOG_LEVEL=INFO
# Log file inside the app containers (the default /var/log/demetra is not
# writable there; compose overrides LOG_PATH=/root/demetra.log so logs and
# session logs persist in the demetra_app_data volume)
LOG_PATH=/var/log/demetra/demetra.log

# Daemons
WATCHER_POLL_INTERVAL=60
LISTENER_POLL_INTERVAL=60
