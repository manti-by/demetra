# Demetra Docker Compose environment
# Copy to .env.docker and fill in real values, e.g.:
#   cp .env.docker.example .env.docker

# Postgres service (db)
POSTGRES_USER=demetra
POSTGRES_DB=demetra
POSTGRES_PASSWORD=change-me

# App database connection (compose overrides DB_HOST=db, DB_PORT=5432)
DB_HOST=db
DB_PORT=5432
DB_USER=demetra
DB_NAME=demetra
DB_PASSWORD=change-me

# Redis (compose overrides REDIS_URL=redis://redis:6379/1)
REDIS_URL=redis://redis:6379/1

# Path inside the app containers where the parent (host) home is mounted
# for auth copying; compose overrides PARENT_HOME=/home/demetra/
PARENT_HOME=/home/demetra/

# Image used by the app services (migrate, api, worker, watcher, listener, rq-dashboard)
DEMETRA_IMAGE=mantiby/demetra:latest

# App secrets - copy real values from the production .env
SECRET_KEY=change-me
ENCRYPTION_SALT=change-me
JWT_SECRET_KEY=change-me
DEFAULT_USER_ID=

# GitHub OAuth + webhook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REDIRECT_URI=https://demetra.manti.by/github/callback

# Linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_TEAM_ID=

# Groq
GROQ_API_KEY=

# Web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
COOKIE_SECURE=true
LOG_LEVEL=INFO
# Log file inside the app containers (the default /var/log/demetra is not
# writable there; compose overrides LOG_PATH=/root/demetra.log so logs and
# session logs persist in the demetra_app_data volume)
LOG_PATH=/root/demetra.log

# Daemons
WATCHER_POLL_INTERVAL=60
LISTENER_POLL_INTERVAL=60
