{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@manti-by/openwiki@0.3.0-rc1"],
  "mcp": {
    "Demetra": {
      "type": "local",
      "command": ["uv", "run", "python", "-m", "demetra.mcp_server"],
      "enabled": true
    },
    "Linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["uvx", "ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  }
}
