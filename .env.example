# Environment variables for Demetra FastAPI application
# Copy this file to .env and fill in the actual values

# Required for Linear integration
LINEAR_API_KEY=your_linear_api_key_here
LINEAR_TEAM_ID=your_linear_team_id_here

# Required for Groq AI processing
GROQ_API_KEY=your_groq_api_key_here

# Optional: Linear state IDs (defaults are provided)
LINEAR_STATE_TODO_ID=9f3c586f-640a-4f78-8170-90217270a0c5
LINEAR_STATE_IN_PROGRESS_ID=ded08079-9ddf-43cb-8aa8-722ba107b691
LINEAR_STATE_IN_REVIEW_ID=34829892-5ab6-40a4-af4e-7a73636a78a4
LINEAR_STATE_AWAITING_INPUT_ID=e733f22b-fe21-401a-bf68-d2d374507f06

# Optional: Project paths
PROJECTS_PATH=/home/manti/www
DB_PATH=/home/manti/.demetra/demetra.sqlite3
GIT_WORKTREE_PATH=/home/manti/.demetra/worktrees/

# Optional: External tool paths
OPENCODE_PATH=/home/manti/.opencode/bin/opencode
CURSOR_PATH=/home/manti/.local/bin/cursor-agent
CODERABBIT_PATH=/home/manti/.local/bin/coderabbit
GH_PATH=/usr/bin/gh

# Optional: Groq model configuration
OPENCODE_MODEL=opencode/minimax-m2.5-free